# Copy this file to .env and fill in your own values. Never commit .env.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Google Gemini API key (aistudio.google.com > Get API key)
GEMINI_API_KEY=
# Optional: pin a specific Gemini model
GEMINI_MODEL=gemini-3.1-flash-lite

# Currency charged for deposits (PayPal supports THB and USD)
CURRENCY=THB
# Share of the slab price taken as a deposit (Blue Sea Wood takes 50%)
DEPOSIT_RATE=0.5

PORT=3001

# Password for the owner desk at /owner (share it with judges in the Devpost testing notes)
ADMIN_KEY=
# Public demo: release test reservations after N minutes so the shop never empties
DEMO_MODE=false
DEMO_RELEASE_MINUTES=30
# "See it in your room" needs a paid Gemini image model
ROOM_PREVIEW=false
# Rough USD hint shown next to THB prices
USD_PER_THB=0.03
