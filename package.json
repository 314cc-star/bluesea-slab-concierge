{
  "name": "bluesea-slab-concierge",
  "version": "0.1.0",
  "private": true,
  "description": "AI slab concierge for Blue Sea Wood: find a one-of-a-kind live-edge slab, reserve it with a PayPal deposit.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"node --watch --env-file-if-exists=.env server/index.js --dev\" \"vite --strictPort\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@paypal/react-paypal-js": "^10.6.1",
    "ag-grid-community": "^36.3.0",
    "ag-grid-react": "^36.3.0",
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "vite": "^8.3.6"
  }
}
